<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ISC Class 12 Organic Chemistry & Name Reactions</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans leading-relaxed">

  <!-- Header / Navigation -->
  <header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <i data-lucide="flask-conical" class="w-6 h-6 text-indigo-600"></i>
        <span class="font-bold text-lg text-slate-900">ISC ChemHub</span>
      </div>
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
        <a href="#overview" class="hover:text-indigo-600 transition">Overview</a>
        <a href="#reactions" class="hover:text-indigo-600 transition">Name Reactions</a>
        <a href="#pdf-viewer" class="hover:text-indigo-600 transition">PDF Viewer</a>
      </nav>
      <a href="assets/ISC_Class_12_Organic_Reactions.pdf" download class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-semibold text-sm transition shadow-sm">
        <i data-lucide="download" class="w-4 h-4"></i> Download PDF
      </a>
    </div>
  </header>

  <!-- Hero Section -->
  <section id="overview" class="py-16 md:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <span class="inline-block px-3 py-1 bg-indigo-100 text-indigo-700 text-xs font-semibold uppercase tracking-wider rounded-full mb-4">ISC Board Chemistry</span>
    <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 tracking-tight mb-6">
      Master Class 12 <span class="text-indigo-600">Organic Reactions</span>
    </h1>
    <p class="max-w-2xl mx-auto text-lg text-slate-600 mb-8">
      Complete compilation of all mechanisms, conversions, and name reactions for the ISC Class 12 Chemistry examination.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a href="assets/ISC_Class_12_Organic_Reactions.pdf" download class="px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg shadow-md transition flex items-center gap-2">
        <i data-lucide="file-text" class="w-5 h-5"></i> Download PDF Master Sheet
      </a>
      <a href="#pdf-viewer" class="px-6 py-3 bg-white border border-slate-300 hover:bg-slate-100 text-slate-700 font-semibold rounded-lg shadow-sm transition flex items-center gap-2">
        <i data-lucide="eye" class="w-5 h-5"></i> Read Online
      </a>
    </div>
  </section>

  <!-- Syllabus Coverage Badge Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
    <div class="bg-indigo-900 text-white rounded-2xl p-6 md:p-10 shadow-xl">
      <h2 class="text-xl md:text-2xl font-bold mb-4 flex items-center gap-2">
        <i data-lucide="check-circle-2" class="text-emerald-400 w-6 h-6"></i> Complete ISC Board Syllabus Covered
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-sm text-indigo-100">
        <div class="flex items-center gap-2 bg-indigo-800/50 p-3 rounded-lg"><i data-lucide="check" class="w-4 h-4 text-emerald-400"></i> Haloalkanes & Haloarenes</div>
        <div class="flex items-center gap-2 bg-indigo-800/50 p-3 rounded-lg"><i data-lucide="check" class="w-4 h-4 text-emerald-400"></i> Alcohols, Phenols & Ethers</div>
        <div class="flex items-center gap-2 bg-indigo-800/50 p-3 rounded-lg"><i data-lucide="check" class="w-4 h-4 text-emerald-400"></i> Aldehydes, Ketones & Carboxylic Acids</div>
        <div class="flex items-center gap-2 bg-indigo-800/50 p-3 rounded-lg"><i data-lucide="check" class="w-4 h-4 text-emerald-400"></i> Nitrogen Compounds (Amines & Diazonium)</div>
        <div class="flex items-center gap-2 bg-indigo-800/50 p-3 rounded-lg"><i data-lucide="check" class="w-4 h-4 text-emerald-400"></i> Biomolecules & Carbohydrates</div>
        <div class="flex items-center gap-2 bg-indigo-800/50 p-3 rounded-lg"><i data-lucide="check" class="w-4 h-4 text-emerald-400"></i> Distinguishing Tests (Iodoform, Lucas, etc.)</div>
      </div>
    </div>
  </section>

  <!-- Name Reactions Reference Section -->
  <section id="reactions" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">Key Name Reactions Cheat Sheet</h2>
        <p class="text-sm text-slate-600">Quick-reference cards for high-yield board exam reactions.</p>
      </div>
      <!-- Search Input -->
      <div class="relative max-w-xs">
        <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
        <input type="text" id="searchInput" placeholder="Search reaction name..." class="w-full pl-9 pr-4 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="reactionGrid">
      <!-- Card 1 -->
      <div class="reaction-card bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition">
        <span class="text-xs font-semibold px-2.5 py-1 bg-amber-100 text-amber-800 rounded-full">Aldehydes & Ketones</span>
        <h3 class="text-lg font-bold text-slate-900 mt-3 mb-2">Aldol Condensation</h3>
        <p class="text-sm text-slate-600 mb-1"><strong class="text-slate-800">Reactants:</strong> Aldehydes/Ketones with &alpha;-H</p>
        <p class="text-sm text-slate-600 mb-3"><strong class="text-slate-800">Reagent:</strong> Dilute NaOH</p>
        <div class="bg-slate-100 p-3 rounded-lg text-xs font-mono text-slate-800">
          2 CH₃CHO &rarr; CH₃-CH(OH)-CH₂-CHO &rarr; CH₃-CH=CH-CHO + H₂O
        </div>
      </div>

      <!-- Card 2 -->
      <div class="reaction-card bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition">
        <span class="text-xs font-semibold px-2.5 py-1 bg-amber-100 text-amber-800 rounded-full">Aldehydes & Ketones</span>
        <h3 class="text-lg font-bold text-slate-900 mt-3 mb-2">Cannizzaro Reaction</h3>
        <p class="text-sm text-slate-600 mb-1"><strong class="text-slate-800">Reactants:</strong> Aldehydes without &alpha;-H</p>
        <p class="text-sm text-slate-600 mb-3"><strong class="text-slate-800">Reagent:</strong> Conc. NaOH (50%)</p>
        <div class="bg-slate-100 p-3 rounded-lg text-xs font-mono text-slate-800">
          2 HCHO + Conc. NaOH &rarr; CH₃OH + HCOONa
        </div>
      </div>

      <!-- Card 3 -->
      <div class="reaction-card bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition">
        <span class="text-xs font-semibold px-2.5 py-1 bg-emerald-100 text-emerald-800 rounded-full">Phenols</span>
        <h3 class="text-lg font-bold text-slate-900 mt-3 mb-2">Reimer-Tiemann Reaction</h3>
        <p class="text-sm text-slate-600 mb-1"><strong class="text-slate-800">Reactants:</strong> Phenol</p>
        <p class="text-sm text-slate-600 mb-3"><strong class="text-slate-800">Reagent:</strong> CHCl₃ + aq. NaOH (340 K)</p>
        <div class="bg-slate-100 p-3 rounded-lg text-xs font-mono text-slate-800">
          Phenol + CHCl₃ + 3 NaOH &rarr; Salicylaldehyde + 3 NaCl + 2 H₂O
        </div>
      </div>

      <!-- Card 4 -->
      <div class="reaction-card bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition">
        <span class="text-xs font-semibold px-2.5 py-1 bg-purple-100 text-purple-800 rounded-full">Amines</span>
        <h3 class="text-lg font-bold text-slate-900 mt-3 mb-2">Hoffmann Bromamide Degradation</h3>
        <p class="text-sm text-slate-600 mb-1"><strong class="text-slate-800">Reactants:</strong> Primary Acid Amide</p>
        <p class="text-sm text-slate-600 mb-3"><strong class="text-slate-800">Reagent:</strong> Br₂ + NaOH / KOH</p>
        <div class="bg-slate-100 p-3 rounded-lg text-xs font-mono text-slate-800">
          R-CONH₂ + Br₂ + 4 NaOH &rarr; R-NH₂ + Na₂CO₃ + 2 NaBr + 2 H₂O
        </div>
      </div>

      <!-- Card 5 -->
      <div class="reaction-card bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition">
        <span class="text-xs font-semibold px-2.5 py-1 bg-emerald-100 text-emerald-800 rounded-full">Phenols</span>
        <h3 class="text-lg font-bold text-slate-900 mt-3 mb-2">Kolbe's Reaction</h3>
        <p class="text-sm text-slate-600 mb-1"><strong class="text-slate-800">Reactants:</strong> Sodium Phenoxide</p>
        <p class="text-sm text-slate-600 mb-3"><strong class="text-slate-800">Reagent:</strong> CO₂ (400 K, 4-7 atm), H⁺</p>
        <div class="bg-slate-100 p-3 rounded-lg text-xs font-mono text-slate-800">
          Phenoxide + CO₂ &rarr; Salicylic Acid (2-hydroxybenzoic acid)
        </div>
      </div>

      <!-- Card 6 -->
      <div class="reaction-card bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition">
        <span class="text-xs font-semibold px-2.5 py-1 bg-purple-100 text-purple-800 rounded-full">Amines</span>
        <h3 class="text-lg font-bold text-slate-900 mt-3 mb-2">Gabriel Phthalimide Synthesis</h3>
        <p class="text-sm text-slate-600 mb-1"><strong class="text-slate-800">Reactants:</strong> Phthalimide, Alkyl Halide</p>
        <p class="text-sm text-slate-600 mb-3"><strong class="text-slate-800">Reagent:</strong> KOH, R-X, aq. NaOH</p>
        <div class="bg-slate-100 p-3 rounded-lg text-xs font-mono text-slate-800">
          Used to prepare pure 1° Aliphatic Amines (Aromatic amines fail)
        </div>
      </div>
    </div>
  </section>

  <!-- PDF Viewer Section -->
  <section id="pdf-viewer" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
    <div class="bg-white border border-slate-200 rounded-2xl p-4 md:p-6 shadow-sm">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2">
          <i data-lucide="book-open" class="w-5 h-5 text-indigo-600"></i>
          <h2 class="text-lg font-bold text-slate-900">Embedded PDF Viewer</h2>
        </div>
        <a href="assets/ISC_Class_12_Organic_Reactions.pdf" download class="text-xs sm:text-sm text-indigo-600 font-semibold hover:underline flex items-center gap-1">
          <i data-lucide="download" class="w-4 h-4"></i> Save PDF File
        </a>
      </div>
      
      <div class="w-full h-[650px] bg-slate-100 rounded-xl overflow-hidden border border-slate-200">
        <!-- Make sure to place your PDF file at assets/ISC_Class_12_Organic_Reactions.pdf -->
        <iframe src="assets/ISC_Class_12_Organic_Reactions.pdf" class="w-full h-full" title="ISC Organic Reactions PDF Document">
          <div class="p-8 text-center text-slate-600">
            <p>Your browser does not support embedded PDF viewing.</p>
            <a href="assets/ISC_Class_12_Organic_Reactions.pdf" download class="mt-4 inline-block px-4 py-2 bg-indigo-600 text-white rounded-md text-sm font-semibold">Download PDF Directly</a>
          </div>
        </iframe>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-slate-900 text-slate-400 py-8 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between text-xs sm:text-sm gap-4">
      <p>&copy; ISC Class 12 Organic Chemistry Resource Hub.</p>
      <p class="text-slate-500">Disclaimer: Not officially affiliated with CISCE.</p>
    </div>
  </footer>

  <!-- Lucide Icon Renderer & Search Script -->
  <script>
    lucide.createIcons();

    // Client-side search filter
    document.getElementById('searchInput').addEventListener('input', function(e) {
      const query = e.target.value.toLowerCase();
      const cards = document.querySelectorAll('.reaction-card');
      cards.forEach(card => {
        const text = card.textContent.toLowerCase();
        card.style.display = text.includes(query) ? 'block' : 'none';
      });
    });
  </script>
</body>
</html>
